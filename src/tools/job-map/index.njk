---
layout: layouts/base.njk
title: "Interactive Job Map — Visa Sponsorship Jobs Worldwide | VisaJobs.xyz"
description: "Explore 270+ visa-sponsored jobs on an interactive world map. Find relocation opportunities near you with our MapTiler-powered global job map."
---

{# Structured Data #}
{% block structuredData %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Interactive Job Map — Visa Sponsorship Jobs Worldwide",
  "url": "{{ site.url }}/tools/job-map/",
  "description": "{{ description }}",
  "applicationCategory": "BusinessApplication",
  "operatingSystem": "Any",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
  "publisher": { "@type": "Organization", "name": "{{ site.name }}", "url": "{{ site.url }}" }
}
</script>
{% endblock %}

{% block head %}
{# MapTiler SDK CSS — required for correct rendering #}
<link rel="stylesheet" href="https://cdn.maptiler.com/maptiler-sdk-js/v2.5.0/maptiler-sdk.css" />
<style>
  #map {
    width: 100%;
    height: 65vh;
    min-height: 420px;
    border-radius: 1rem;
    overflow: hidden;
    border: 1px solid rgba(0,0,0,0.08);
  }
  .dark #map { border-color: rgba(255,255,255,0.06); }
  .maplibregl-popup-content {
    border-radius: 12px !important;
    padding: 0 !important;
    box-shadow: 0 8px 30px rgba(0,0,0,0.12) !important;
    overflow: hidden;
    max-width: 320px;
  }
  .dark .maplibregl-popup-content {
    background: #1f2937 !important;
    color: #f3f4f6 !important;
  }
  .dark .maplibregl-popup-tip {
    border-top-color: #1f2937 !important;
    border-bottom-color: #1f2937 !important;
  }
  .job-popup { padding: 16px; }
  .job-popup h3 { font-size: 14px; font-weight: 700; margin: 0 0 4px; line-height: 1.3; }
  .job-popup .company { font-size: 13px; color: #6b7280; margin-bottom: 6px; }
  .job-popup .badges { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 10px; }
  .job-popup .badge-sm {
    font-size: 10px; padding: 2px 8px; border-radius: 99px; font-weight: 600;
    background: #dbeafe; color: #1d4ed8;
  }
  .dark .job-popup .badge-sm { background: #1e3a5f; color: #93c5fd; }
  .job-popup .badge-visa { background: #dcfce7; color: #166534; }
  .dark .job-popup .badge-visa { background: #14532d; color: #86efac; }
  .job-popup .apply-btn {
    display: inline-flex; align-items: center; gap: 6px;
    font-size: 12px; font-weight: 600; color: #fff;
    background: linear-gradient(135deg, #6366f1, #8b5cf6);
    padding: 6px 14px; border-radius: 8px; text-decoration: none;
    transition: opacity 0.2s;
  }
  .job-popup .apply-btn:hover { opacity: 0.85; }

  /* Cluster styling */
  .cluster-marker {
    display: flex; align-items: center; justify-content: center;
    border-radius: 50%; font-weight: 700; color: #fff;
    box-shadow: 0 2px 8px rgba(0,0,0,0.2);
    transition: transform 0.2s;
    cursor: pointer;
  }
  .cluster-marker:hover { transform: scale(1.15); }
  .cluster-sm { width: 36px; height: 36px; font-size: 13px; background: linear-gradient(135deg, #6366f1, #8b5cf6); }
  .cluster-md { width: 44px; height: 44px; font-size: 14px; background: linear-gradient(135deg, #4f46e5, #7c3aed); }
  .cluster-lg { width: 52px; height: 52px; font-size: 15px; background: linear-gradient(135deg, #4338ca, #6d28d9); }

  /* Stats bar */
  .map-stat {
    display: flex; flex-direction: column; align-items: center;
    padding: 12px 20px;
  }
  .map-stat-value { font-size: 1.5rem; font-weight: 800; }
  .map-stat-label { font-size: 0.75rem; color: #6b7280; }

  /* Map controls override */
  .maplibregl-ctrl-group { border-radius: 12px !important; overflow: hidden; }
  .maplibregl-ctrl-group button { width: 36px !important; height: 36px !important; }

  /* Loading overlay */
  #map-loading {
    position: absolute; inset: 0; display: flex; flex-direction: column;
    align-items: center; justify-content: center; background: rgba(255,255,255,0.85);
    border-radius: 1rem; z-index: 10; gap: 12px;
    transition: opacity 0.3s;
  }
  .dark #map-loading { background: rgba(17,24,39,0.85); }
  #map-loading.hidden { opacity: 0; pointer-events: none; }
  .spinner {
    width: 32px; height: 32px; border: 3px solid #e5e7eb;
    border-top-color: #6366f1; border-radius: 50%; animation: spin 0.8s linear infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }
</style>
{% endblock %}

{# Hero #}
<section class="relative overflow-hidden bg-gradient-to-br from-brand-50 via-white to-indigo-50 dark:from-gray-950 dark:via-gray-900 dark:to-gray-950 py-12 md:py-16">
  <div class="max-w-6xl mx-auto px-4">
    <nav class="flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400 mb-6">
      <a href="/" class="hover:text-brand-600 dark:hover:text-brand-400">Home</a>
      <i data-lucide="chevron-right" class="w-4 h-4"></i>
      <span>Tools</span>
      <i data-lucide="chevron-right" class="w-4 h-4"></i>
      <span class="text-gray-900 dark:text-white">Job Map</span>
    </nav>

    <div class="text-center mb-8">
      <div class="w-16 h-16 bg-indigo-100 dark:bg-indigo-900/30 rounded-2xl flex items-center justify-center mx-auto mb-6">
        <i data-lucide="globe-2" class="w-8 h-8 text-indigo-600 dark:text-indigo-400"></i>
      </div>
      <h1 class="text-4xl md:text-5xl font-extrabold text-gray-900 dark:text-white mb-4 leading-tight">
        Explore Jobs on a <span class="bg-indigo-200 dark:bg-indigo-500/20 dark:text-indigo-300 px-2 inline-block -skew-x-1">World Map</span>
      </h1>
      <p class="text-lg text-gray-600 dark:text-gray-400 max-w-2xl mx-auto">
        {{ jobs | length }}+ visa-sponsored positions across the globe. Click a cluster to zoom in, click a marker to see the job.
      </p>
    </div>

    {# Stats bar #}
    <div class="flex items-center justify-center gap-6 md:gap-10 mb-8">
      <div class="map-stat">
        <span class="map-stat-value text-gray-900 dark:text-white" id="stat-jobs">{{ jobs | length }}</span>
        <span class="map-stat-label dark:text-gray-400">Jobs</span>
      </div>
      <div class="w-px h-10 bg-gray-200 dark:bg-gray-700"></div>
      <div class="map-stat">
        <span class="map-stat-value text-gray-900 dark:text-white" id="stat-countries">0</span>
        <span class="map-stat-label dark:text-gray-400">Countries</span>
      </div>
      <div class="w-px h-10 bg-gray-200 dark:bg-gray-700"></div>
      <div class="map-stat">
        <span class="map-stat-value text-gray-900 dark:text-white" id="stat-companies">0</span>
        <span class="map-stat-label dark:text-gray-400">Companies</span>
      </div>
    </div>

    {# Search/filter bar #}
    <div class="card p-4 mb-6 max-w-3xl mx-auto">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
        <div class="relative sm:col-span-2">
          <i data-lucide="search" class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-gray-400"></i>
          <input id="mapSearch" type="text" placeholder="Search by company or position..."
            class="input-field pl-10 text-sm">
        </div>
        <select id="mapCountryFilter" class="input-field text-sm">
          <option value="">All Countries</option>
          {% for country in jobs | uniqueCountries %}
          <option value="{{ country | lower }}">{{ country }}</option>
          {% endfor %}
        </select>
      </div>
    </div>

    {# Map container #}
    <div class="relative">
      <div id="map"></div>
      <div id="map-loading">
        <div class="spinner"></div>
        <span class="text-sm text-gray-600 dark:text-gray-400">Loading map & geocoding jobs…</span>
      </div>
    </div>

    {# MapTiler attribution #}
    <p class="text-center text-xs text-gray-400 dark:text-gray-500 mt-3">
      Map powered by <a href="https://www.maptiler.com/" target="_blank" rel="noopener" class="underline hover:text-brand-600">MapTiler</a>
    </p>
  </div>
</section>

{# Related Tools #}
<section class="py-12">
  <div class="max-w-4xl mx-auto px-4">
    <h2 class="section-heading mb-6">Explore More Tools</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      <a href="/visa-sponsored-jobs/" class="card p-5 hover:border-brand-300 dark:hover:border-brand-700 group">
        <i data-lucide="briefcase" class="w-5 h-5 text-brand-500 mb-2"></i>
        <div class="font-semibold text-gray-900 dark:text-white group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">All Jobs</div>
        <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">Browse the full job listing</p>
      </a>
      <a href="/tools/cost-of-living/" class="card p-5 hover:border-brand-300 dark:hover:border-brand-700 group">
        <i data-lucide="map-pin" class="w-5 h-5 text-brand-500 mb-2"></i>
        <div class="font-semibold text-gray-900 dark:text-white group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">Cost of Living</div>
        <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">Compare cities worldwide</p>
      </a>
      <a href="/tools/visa-checker/" class="card p-5 hover:border-brand-300 dark:hover:border-brand-700 group">
        <i data-lucide="shield-check" class="w-5 h-5 text-brand-500 mb-2"></i>
        <div class="font-semibold text-gray-900 dark:text-white group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors">Visa Checker</div>
        <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">Check company sponsorship</p>
      </a>
    </div>
  </div>
</section>

{% block scripts %}
{# MapTiler SDK JS v2 — loaded via CDN as per the MapTiler Agent Skill best practices #}
<script src="https://cdn.maptiler.com/maptiler-sdk-js/v2.5.0/maptiler-sdk.umd.js"></script>
<script>
(function() {
  'use strict';

  // ─── MapTiler SDK configuration ────────────────────────────────────────────
  // API key + dark/light style detection as recommended by MapTiler Agent Skill
  var MAPTILER_API_KEY = 'FVA0WUela5uvLwjsqkPR';
  maptilersdk.config.apiKey = MAPTILER_API_KEY;

  var isDark = document.documentElement.classList.contains('dark') ||
               window.matchMedia('(prefers-color-scheme: dark)').matches;

  // Use MapTiler v4 modern styles (v4 are current, v3 are deprecated per Agent Skill)
  var mapStyle = isDark
    ? maptilersdk.MapStyle.STREETS.DARK
    : maptilersdk.MapStyle.STREETS;

  // ─── Initialize MapTiler Map ───────────────────────────────────────────────
  var map = new maptilersdk.Map({
    container: 'map',
    style: mapStyle,
    center: [10, 48],       // Europe-centered default
    zoom: 3,
    navigationControl: true,
    geolocateControl: false,
    terrainControl: false,
    maxZoom: 16,
    minZoom: 1.5
  });

  // ─── Job Data — pre-rendered at build time by Eleventy ─────────────────────
  var allJobs = [
    {% for job in jobs %}
    {
      company: {{ job.company | jsonify | safe }},
      position: {{ job.position | jsonify | safe }},
      location: {{ job.location | jsonify | safe }},
      visa: {{ job.visa | jsonify | safe }},
      reloc: {{ job.reloc | jsonify | safe }},
      contract: {{ job.contract | jsonify | safe }},
      url: {{ job.description | jsonify | safe }},
      slug: {{ (job | jobSlug) | jsonify | safe }},
      postDate: {{ job.post_date | jsonify | safe }}
    }{% if not loop.last %},{% endif %}
    {% endfor %}
  ];

  // ─── Stats computation ─────────────────────────────────────────────────────
  var countrySet = new Set();
  var companySet = new Set();
  allJobs.forEach(function(j) {
    if (j.company) companySet.add(j.company);
    var loc = (j.location || '').trim();
    var parts = loc.split(/,\s*/);
    var lastPart = parts[parts.length - 1].trim();
    if (lastPart) countrySet.add(lastPart);
  });
  document.getElementById('stat-countries').textContent = countrySet.size;
  document.getElementById('stat-companies').textContent = companySet.size;

  // ─── Geocoding via MapTiler Geocoding API ──────────────────────────────────
  // Uses the MapTiler Geocoding REST API to resolve job locations to coordinates.
  // We batch-geocode unique locations and cache results to minimize API calls.
  var geocodeCache = {};
  var GEOCODE_ENDPOINT = 'https://api.maptiler.com/geocoding/';

  function normalizeLocation(loc) {
    // Clean up multi-line locations from the jobs data
    return loc.replace(/\s*\n\s*/g, ', ').replace(/,\s*,/g, ',').replace(/,\s*$/, '').trim();
  }

  function geocodeLocation(location) {
    var norm = normalizeLocation(location);
    if (geocodeCache[norm] !== undefined) {
      return Promise.resolve(geocodeCache[norm]);
    }
    var url = GEOCODE_ENDPOINT + encodeURIComponent(norm) + '.json?key=' + MAPTILER_API_KEY + '&limit=1';
    return fetch(url).then(function(r) { return r.json(); }).then(function(data) {
      if (data.features && data.features.length > 0) {
        var coords = data.features[0].center; // [lng, lat]
        geocodeCache[norm] = coords;
        return coords;
      }
      geocodeCache[norm] = null;
      return null;
    }).catch(function() {
      geocodeCache[norm] = null;
      return null;
    });
  }

  // ─── Build GeoJSON from jobs ───────────────────────────────────────────────
  function buildGeoJSON(jobsWithCoords) {
    return {
      type: 'FeatureCollection',
      features: jobsWithCoords.map(function(j) {
        return {
          type: 'Feature',
          geometry: { type: 'Point', coordinates: j.coords },
          properties: {
            company: j.company,
            position: j.position,
            location: normalizeLocation(j.location),
            visa: j.visa,
            reloc: j.reloc,
            contract: j.contract,
            url: j.url,
            slug: j.slug,
            postDate: j.postDate
          }
        };
      })
    };
  }

  // ─── Popup HTML ────────────────────────────────────────────────────────────
  function popupHTML(props) {
    var html = '<div class="job-popup">';
    html += '<h3>' + escapeHtml(props.position) + '</h3>';
    html += '<div class="company">' + escapeHtml(props.company) + ' · ' + escapeHtml(props.location) + '</div>';
    html += '<div class="badges">';
    if (props.visa) html += '<span class="badge-sm badge-visa">' + escapeHtml(props.visa) + '</span>';
    if (props.contract) html += '<span class="badge-sm">' + escapeHtml(props.contract) + '</span>';
    html += '</div>';
    html += '<div style="display:flex;gap:8px">';
    html += '<a class="apply-btn" href="/visa-sponsored-jobs/' + props.slug + '/">View Details</a>';
    if (props.url) html += '<a class="apply-btn" style="background:linear-gradient(135deg,#059669,#10b981)" href="' + escapeHtml(props.url) + '" target="_blank" rel="noopener">Apply ↗</a>';
    html += '</div></div>';
    return html;
  }

  function escapeHtml(str) {
    if (!str) return '';
    return str.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  // ─── Main initialization ──────────────────────────────────────────────────
  var allJobsWithCoords = [];
  var currentGeoJSON = null;
  var mapLoaded = false;

  map.on('load', function() {
    mapLoaded = true;

    // Deduplicate locations for geocoding efficiency
    var uniqueLocations = {};
    allJobs.forEach(function(j) {
      var norm = normalizeLocation(j.location);
      if (!uniqueLocations[norm]) uniqueLocations[norm] = [];
      uniqueLocations[norm].push(j);
    });

    var locationKeys = Object.keys(uniqueLocations);
    var batchSize = 5; // Throttle to avoid rate limits on MapTiler Geocoding API
    var index = 0;

    function processBatch() {
      var batch = locationKeys.slice(index, index + batchSize);
      if (batch.length === 0) {
        // All geocoded — render the map
        renderMap();
        return;
      }

      var promises = batch.map(function(loc) {
        return geocodeLocation(loc).then(function(coords) {
          if (coords) {
            // Add slight random offset for jobs at the exact same location
            var jobsAtLoc = uniqueLocations[normalizeLocation(loc)] || uniqueLocations[loc];
            if (jobsAtLoc) {
              jobsAtLoc.forEach(function(j, i) {
                var offset = i * 0.002;
                allJobsWithCoords.push({
                  company: j.company, position: j.position, location: j.location,
                  visa: j.visa, reloc: j.reloc, contract: j.contract,
                  url: j.url, slug: j.slug, postDate: j.postDate,
                  coords: [coords[0] + offset, coords[1] + (offset * 0.5)]
                });
              });
            }
          }
        });
      });

      Promise.all(promises).then(function() {
        index += batchSize;
        // Update loading progress
        var pct = Math.min(100, Math.round(index / locationKeys.length * 100));
        var loadingEl = document.getElementById('map-loading');
        if (loadingEl) loadingEl.querySelector('span').textContent = 'Geocoding locations… ' + pct + '%';
        setTimeout(processBatch, 100); // Small delay to be polite to the API
      });
    }

    processBatch();
  });

  function renderMap() {
    document.getElementById('map-loading').classList.add('hidden');
    if (allJobsWithCoords.length === 0) return;

    currentGeoJSON = buildGeoJSON(allJobsWithCoords);

    // Add GeoJSON source with clustering enabled
    map.addSource('jobs', {
      type: 'geojson',
      data: currentGeoJSON,
      cluster: true,
      clusterRadius: 60,
      clusterMaxZoom: 14
    });

    // Cluster circle layer — sized by point_count
    map.addLayer({
      id: 'clusters',
      type: 'circle',
      source: 'jobs',
      filter: ['has', 'point_count'],
      paint: {
        'circle-color': [
          'step', ['get', 'point_count'],
          '#818cf8', 10,   // indigo-400
          '#6366f1', 30,   // indigo-500
          '#4f46e5', 100,  // indigo-600
          '#4338ca'        // indigo-700
        ],
        'circle-radius': [
          'step', ['get', 'point_count'],
          18, 10,
          22, 30,
          26, 100,
          30
        ],
        'circle-stroke-width': 3,
        'circle-stroke-color': 'rgba(255,255,255,0.5)'
      }
    });

    // Cluster count labels
    map.addLayer({
      id: 'cluster-count',
      type: 'symbol',
      source: 'jobs',
      filter: ['has', 'point_count'],
      layout: {
        'text-field': '{point_count_abbreviated}',
        'text-font': ['Noto Sans Bold'],
        'text-size': 13
      },
      paint: {
        'text-color': '#ffffff'
      }
    });

    // Individual unclustered job markers
    map.addLayer({
      id: 'unclustered-point',
      type: 'circle',
      source: 'jobs',
      filter: ['!', ['has', 'point_count']],
      paint: {
        'circle-color': '#6366f1',
        'circle-radius': 7,
        'circle-stroke-width': 2.5,
        'circle-stroke-color': '#ffffff'
      }
    });

    // Click on cluster → zoom in
    map.on('click', 'clusters', function(e) {
      var features = map.queryRenderedFeatures(e.point, { layers: ['clusters'] });
      if (!features.length) return;
      var clusterId = features[0].properties.cluster_id;
      map.getSource('jobs').getClusterExpansionZoom(clusterId).then(function(zoom) {
        map.easeTo({ center: features[0].geometry.coordinates, zoom: zoom });
      });
    });

    // Click on individual point → show popup
    map.on('click', 'unclustered-point', function(e) {
      if (!e.features || !e.features.length) return;
      var coords = e.features[0].geometry.coordinates.slice();
      var props = e.features[0].properties;
      // Ensure popup is visible when wrapping
      while (Math.abs(e.lngLat.lng - coords[0]) > 180) {
        coords[0] += e.lngLat.lng > coords[0] ? 360 : -360;
      }
      new maptilersdk.Popup({ offset: 12, maxWidth: '320px' })
        .setLngLat(coords)
        .setHTML(popupHTML(props))
        .addTo(map);
    });

    // Cursor styles for interactivity
    map.on('mouseenter', 'clusters', function() { map.getCanvas().style.cursor = 'pointer'; });
    map.on('mouseleave', 'clusters', function() { map.getCanvas().style.cursor = ''; });
    map.on('mouseenter', 'unclustered-point', function() { map.getCanvas().style.cursor = 'pointer'; });
    map.on('mouseleave', 'unclustered-point', function() { map.getCanvas().style.cursor = ''; });
  }

  // ─── Search & Filter ──────────────────────────────────────────────────────
  var searchInput = document.getElementById('mapSearch');
  var countryFilter = document.getElementById('mapCountryFilter');

  function applyFilters() {
    var query = (searchInput.value || '').toLowerCase().trim();
    var country = (countryFilter.value || '').toLowerCase();
    var filtered = allJobsWithCoords.filter(function(j) {
      var matchesSearch = !query ||
        (j.company || '').toLowerCase().includes(query) ||
        (j.position || '').toLowerCase().includes(query);
      var matchesCountry = !country ||
        normalizeLocation(j.location).toLowerCase().includes(country);
      return matchesSearch && matchesCountry;
    });

    var geo = buildGeoJSON(filtered);
    var src = map.getSource('jobs');
    if (src) src.setData(geo);

    document.getElementById('stat-jobs').textContent = filtered.length;
  }

  function debounce(fn, ms) {
    var t; return function() { clearTimeout(t); t = setTimeout(fn, ms); };
  }

  if (searchInput) searchInput.addEventListener('input', debounce(applyFilters, 300));
  if (countryFilter) countryFilter.addEventListener('change', applyFilters);

  // ─── Dark mode sync ────────────────────────────────────────────────────────
  // Watch for theme changes and update the map style accordingly
  var observer = new MutationObserver(function(mutations) {
    mutations.forEach(function(m) {
      if (m.attributeName === 'class') {
        var nowDark = document.documentElement.classList.contains('dark');
        var newStyle = nowDark ? maptilersdk.MapStyle.STREETS.DARK : maptilersdk.MapStyle.STREETS;
        map.setStyle(newStyle);
        // Re-add layers after style change
        map.once('style.load', function() {
          if (allJobsWithCoords.length > 0) renderMap();
        });
      }
    });
  });
  observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
})();
</script>
{% endblock %}
