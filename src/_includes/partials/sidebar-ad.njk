{# Sidebar Ad — Zapply.jobs (Sponsored) #}
{# Uses advertiser-approved assets only. Destination URL per agreement. #}
<aside id="sidebar-ad-zapply" class="relative group">
  {# Dismiss button #}
  <button onclick="document.getElementById('sidebar-ad-wrapper').style.display='none'" 
          title="Dismiss ad" 
          aria-label="Close ad"
          class="absolute -top-2.5 -right-2.5 z-50 w-6 h-6 rounded-full bg-gray-800 border border-gray-700 text-gray-400 hover:text-white flex items-center justify-center text-xs shadow-md transition-colors">
    ✕
  </button>

  <a href="https://app.zapply.jobs/onboarding/?ref=website-cta-Lamiiine" target="_blank" rel="noopener sponsored"
     class="block overflow-hidden rounded-2xl border-2 border-orange-500/40 bg-gray-950 shadow-2xl group-hover:-translate-y-1 transition-all duration-300 relative">

    {# Sponsored label #}
    <div class="px-3 pt-3">
      <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[9px] font-bold bg-white/10 text-gray-300">
        Sponsored
      </span>
    </div>

    {# Banner image #}
    <div class="p-3 pb-2">
      <img src="/media/zapply_banner.png" alt="Apply Faster with Zapply — Apply to jobs in seconds" class="w-full h-auto rounded-lg block" loading="lazy">
    </div>

    {# CTA button — constrained #}
    <div class="px-3 pb-3">
      <img src="/media/zapply_button.png" alt="Get Started with Zapply" class="h-9 w-auto mx-auto rounded-md shadow-lg group-hover:scale-105 transition-transform duration-200" loading="lazy">
    </div>
  </a>
</aside>

