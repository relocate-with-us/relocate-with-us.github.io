---
pagination:
  data: jobs
  size: 1
  alias: job
permalink: "/visa-sponsored-jobs/{{ job | jobSlug }}/index.html"
layout: layouts/base.njk
eleventyComputed:
  title: "{{ job.position }} at {{ job.company }}"
  description: "{{ job.position }} at {{ job.company }} in {{ job.location }}. Sponsorship evidence: {{ job.sponsorship_evidence or 'unverified' }}."
---

{% block structuredData %}
{% set emp = job.employmentType or (job.contract | employmentType) %}
{% set city = job.address.addressLocality if job.address and job.address.addressLocality else (job.location | extractCity) %}
{% set region = job.address.addressRegion if job.address and job.address.addressRegion else (city or "Remote") %}
{% set country = job.address.addressCountry if job.address and job.address.addressCountry else (job.location | countryCode) %}
{% set countryName = job.country or country or "Remote" %}
{% set remote = job.jobLocationType == "TELECOMMUTE" or "remote" in (job.location | lower) %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "JobPosting",
  "title": {{ job.position | jsonify | safe }},
  "description": {{ (job.body or job.summary or job.sponsorship_quote or job.position) | jsonify | safe }},
  "datePosted": "{{ job.posted_at or (job.post_date | isoDate) }}",
  "validThrough": "{{ job.valid_through or (job.post_date | validThrough) }}",
  "employmentType": "{{ emp }}",
  "directApply": false,
  {% if job.salary and job.salary.min %}
  "baseSalary": {
    "@type": "MonetaryAmount",
    "currency": "{{ job.salary.currency }}",
    "value": {
      "@type": "QuantitativeValue",
      "minValue": {{ job.salary.min }},
      {% if job.salary.max %}"maxValue": {{ job.salary.max }},{% endif %}
      "unitText": "{{ job.salary.unit or 'YEAR' }}"
    }
  },
  {% endif %}
  "hiringOrganization": {
    "@type": "Organization",
    "name": {{ job.company | jsonify | safe }}{% if job.logo %},
    "logo": "{{ site.url }}{{ job.logo }}"{% endif %}
  },
  "jobLocation": {
    "@type": "Place",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": {{ (city or region) | jsonify | safe }},
      "addressRegion": {{ region | jsonify | safe }}{% if country %},
      "addressCountry": "{{ country }}"{% endif %}
    }
  }{% if remote %},
  "jobLocationType": "TELECOMMUTE",
  "applicantLocationRequirements": {
    "@type": "Country",
    "name": {{ countryName | jsonify | safe }}
  }{% endif %},
  "url": "{{ site.url }}/visa-sponsored-jobs/{{ job | jobSlug }}/"
}
</script>
{% endblock %}

<section class="bg-gradient-to-b from-brand-50 to-white dark:from-gray-900 dark:to-gray-950 py-12">
  <div class="max-w-3xl mx-auto px-4">
    <nav class="text-sm text-gray-500 dark:text-gray-400 mb-6">
      <a href="/" class="hover:text-brand-600">Home</a>
      <span class="mx-2">/</span>
      <a href="/visa-sponsored-jobs/" class="hover:text-brand-600">Jobs</a>
      <span class="mx-2">/</span>
      <span class="text-gray-900 dark:text-white truncate max-w-[200px] inline-block align-bottom">{{ job.position }}</span>
    </nav>

    <div class="card p-6 sm:p-8 mb-8">
      <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-6 pb-6 border-b dark:border-gray-800">
        <div class="flex items-start gap-4">
          <img src="{{ job | companyLogo }}" alt="{{ job.company }}" class="w-16 h-16 rounded-xl object-cover shrink-0 border dark:border-gray-800" onerror="this.onerror=null;this.src='/favicon/android-chrome-192x192.png'">
          <div>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-gray-900 dark:text-white mb-2 leading-tight">{{ job.position }}</h1>
            <p class="text-lg text-gray-600 dark:text-gray-400 font-medium mb-1">{{ job.company }}</p>
            <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-gray-500 dark:text-gray-400">
              <span class="flex items-center gap-1">
                <i data-lucide="map-pin" class="w-4 h-4"></i>
                {{ job.location }}
              </span>
              <span class="flex items-center gap-1">
                <i data-lucide="calendar" class="w-4 h-4"></i>
                Posted {% set postedAt = job.posted_at or job.post_date %}<time class="js-timeago" datetime="{{ postedAt }}" title="{{ postedAt }}">{{ postedAt | timeAgo }}</time>
                <span class="text-gray-400">· {{ job.post_date }}</span>
              </span>
              {% if job.updated_at and job.updated_at.slice(0,10) != job.post_date %}
              <span class="flex items-center gap-1">
                <i data-lucide="refresh-cw" class="w-4 h-4"></i>
                Updated <time class="js-timeago" datetime="{{ job.updated_at }}" title="{{ job.updated_at }}">{{ job.updated_at | timeAgo }}</time>
              </span>
              {% endif %}
              {% if job.valid_through %}
              <span class="flex items-center gap-1">
                <i data-lucide="calendar-clock" class="w-4 h-4"></i>
                Valid through {{ job.valid_through }}
              </span>
              {% endif %}
            </div>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 py-6">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-lg bg-brand-50 dark:bg-brand-950/40 flex items-center justify-center text-brand-600 dark:text-brand-400">
            <i data-lucide="briefcase" class="w-5 h-5"></i>
          </div>
          <div>
            <p class="text-xs text-gray-500 dark:text-gray-400">Job Type</p>
            <p class="text-sm font-semibold text-gray-900 dark:text-white">{{ job.contract or "Not specified" }}{% if job.department %} · {{ job.department }}{% endif %}</p>
          </div>
        </div>
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-lg bg-green-50 dark:bg-green-950/40 flex items-center justify-center text-green-600 dark:text-green-400">
            <i data-lucide="shield-check" class="w-5 h-5"></i>
          </div>
          <div>
            <p class="text-xs text-gray-500 dark:text-gray-400">Visa Sponsorship</p>
            <p class="text-sm font-semibold text-gray-900 dark:text-white">{{ job.visa or "Not stated" }}</p>
          </div>
        </div>
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-lg bg-purple-50 dark:bg-purple-950/40 flex items-center justify-center text-purple-600 dark:text-purple-400">
            <i data-lucide="plane" class="w-5 h-5"></i>
          </div>
          <div>
            <p class="text-xs text-gray-500 dark:text-gray-400">Relocation Support</p>
            <p class="text-sm font-semibold text-gray-900 dark:text-white">{{ job.reloc or "Not stated" }}</p>
          </div>
        </div>
      </div>

      {% if job.deadline %}
      <p class="text-sm text-gray-700 dark:text-gray-300 pb-2">Apply by {{ job.deadline }}</p>
      {% endif %}

      {% if job.salary and job.salary.min %}
      <p class="text-sm text-gray-700 dark:text-gray-300 pb-4">
        Salary: {{ job.salary.currency }} {{ job.salary.min }}{% if job.salary.max %}–{{ job.salary.max }}{% endif %}
        per {{ (job.salary.unit or "YEAR") | lower }}
      </p>
      {% endif %}

      <div class="pt-6 border-t dark:border-gray-800 text-center sm:text-left flex flex-col sm:flex-row items-center justify-between gap-4">
        <div>
          <p class="text-sm font-medium text-gray-900 dark:text-white">Ready to apply?</p>
          <p class="text-xs text-gray-500 dark:text-gray-400">This link goes to the employer or their applicant tracking system.</p>
        </div>
        <a href="{{ job.description }}" target="_blank" rel="noopener" class="btn-primary w-full sm:w-auto inline-flex items-center justify-center">
          Apply to {{ job.company }}
          <i data-lucide="external-link" class="w-4 h-4 ml-2"></i>
        </a>
      </div>
    </div>

    {% if job.body %}
    <div class="card p-6 sm:p-8 mb-8">
      <h2 class="text-lg font-bold text-gray-900 dark:text-white mb-4 flex items-center gap-2">
        <i data-lucide="file-text" class="w-5 h-5 text-brand-500"></i>
        Job description
      </h2>
      <div class="text-sm text-gray-700 dark:text-gray-300 leading-relaxed space-y-3">
        {% for para in job.body.split("\n\n") %}
          {% if para.trim() %}<p class="whitespace-pre-line">{{ para }}</p>{% endif %}
        {% endfor %}
      </div>
    </div>
    {% endif %}

    <div class="card p-6 sm:p-8 mb-8">
      <h2 class="text-lg font-bold text-gray-900 dark:text-white mb-4 flex items-center gap-2">
        <i data-lucide="shield-check" class="w-5 h-5 text-brand-500"></i>
        Sponsorship evidence
      </h2>
      <div class="prose-custom text-sm text-gray-600 dark:text-gray-400 leading-relaxed space-y-4">
        <p>
          <strong>{{ job.company }}</strong> is hiring a <strong>{{ job.position }}</strong>
          {% if job.location %}based in <strong>{{ job.location }}</strong>{% endif %}.
          {% if job.contract %}The posting is listed as <strong>{{ job.contract }}</strong>.{% endif %}
        </p>
        {% if job.sponsorship_evidence == "confirmed" %}
        <p>The employer posting states visa sponsorship. Evidence ({{ job.sponsorship_evidence }}):</p>
        <blockquote class="border-l-4 border-brand-500 pl-4 italic">{{ job.sponsorship_quote }}</blockquote>
        {% elif job.sponsorship_evidence == "likely" %}
        <p>{{ job.sponsorship_quote }}</p>
        <p>This is marked <strong>likely</strong>, not confirmed. Read the employer posting before you apply.</p>
        {% else %}
        <p>This listing does not have sponsorship evidence and should not be treated as a visa-sponsored role.</p>
        {% endif %}
        {% if job.reloc %}
        <p>Relocation assistance is mentioned in the posting{% if job.relocation_quote %}: {{ job.relocation_quote }}{% endif %}.</p>
        {% else %}
        <p>The posting does not mention a relocation package. Relocation is not claimed for this role.</p>
        {% endif %}
        <p>Valid through {{ job.valid_through or (job.post_date | validThrough) }}. After that date the listing is removed unless the employer posting is still open.</p>
        <div class="mt-6">
          <a href="{{ job.description }}" target="_blank" rel="noopener" class="btn-primary inline-flex items-center">
            View the employer posting
            <i data-lucide="external-link" class="w-4 h-4 ml-2"></i>
          </a>
        </div>
      </div>
    </div>

    <h2 class="section-heading mb-4 mt-8">More jobs</h2>
    <div class="space-y-4 mb-8">
      {% set relatedCount = 0 %}
      {% for rJob in jobs %}
        {% if rJob.location == job.location and rJob.position != job.position and relatedCount < 3 %}
          <div class="job-card">
            <div class="flex items-center justify-between gap-4">
              <div>
                <h4 class="font-semibold text-gray-900 dark:text-white text-sm">
                  <a href="/visa-sponsored-jobs/{{ rJob | jobSlug }}/" class="hover:text-brand-600">{{ rJob.position }}</a>
                </h4>
                <p class="text-xs text-gray-500 dark:text-gray-400">{{ rJob.company }} &middot; {{ rJob.location }}</p>
              </div>
              <a href="/visa-sponsored-jobs/{{ rJob | jobSlug }}/" class="btn-secondary text-xs px-3 py-1.5 whitespace-nowrap">View Job</a>
            </div>
          </div>
          {% set relatedCount = relatedCount + 1 %}
        {% endif %}
      {% endfor %}
    </div>

    <div class="text-center">
      <a href="/visa-sponsored-jobs/" class="inline-flex items-center text-brand-600 dark:text-brand-400 hover:underline">
        <i data-lucide="arrow-left" class="w-4 h-4 mr-2"></i>
        Back to all jobs
      </a>
    </div>
  </div>
</section>
